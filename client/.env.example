# Fitney client — environment (client-safe values only).
# Real values live in client/.env (git-ignored). Never commit a populated .env.
# The service-role key and any server secret NEVER appear here or in the bundle
# (CON-4). Only the publishable / anon key + project URL are client-safe.

# Local Supabase stack (`supabase start` on the repo root prints throwaway keys):
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Hosted fitney-dev (DEP-1, development only):
# EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<publishable anon key for fitney-dev>

# Sync tunables (services/Config; safe defaults baked in if unset):
# EXPO_PUBLIC_FULL_RECONCILE_INTERVAL_HOURS=24
