{
  "name": "fitney-client",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:logic": "tsc --noEmit -p tsconfig.logic.json",
    "lint": "eslint .",
    "lint:boundaries": "depcruise src app --config .dependency-cruiser.cjs",
    "test": "jest --config jest.config.cjs",
    "verify": "npm run typecheck:logic && npm run lint:boundaries && npm run test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "expo": "54.0.37",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/jest": "^29.5.13",
    "@types/react": "~19.1.0",
    "better-sqlite3": "^11.8.1",
    "dependency-cruiser": "^16.4.2",
    "eslint": "^9.16.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
