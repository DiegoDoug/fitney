# =============================================================================
# Supabase — Weight / Fitney  (platform-release, phase 8)
# =============================================================================
# Environment separation: local | development | production. Never commit real
# values. The service-role / secret key is SERVER-ONLY and must never be shipped
# in client code or artifacts (CLAUDE.md, CON-4). Local `supabase start` prints
# CLI-generated throwaway keys valid only on 127.0.0.1 — do not reuse elsewhere.

# ---- CLIENT-SAFE (safe to bundle in the Expo app for the given environment) ----
EXPO_PUBLIC_SUPABASE_URL=              # e.g. https://<project-ref>.supabase.co  (local: http://127.0.0.1:54321)
EXPO_PUBLIC_SUPABASE_ANON_KEY=         # publishable / anon key for THIS environment only

# ---- SERVER-ONLY (Edge Function / CI secrets — inject via `supabase secrets set`
#      or the GitHub Actions secret store; never in the client, never in git) ----
SUPABASE_SERVICE_ROLE_KEY=            # delete-account Edge Function only
DELETION_RECEIPT_HMAC_KEY=           # keyed HMAC for deletion_receipts.user_ref (SEC-DEC-04)
SUPABASE_DB_URL=                     # migrations / CI only (postgresql://...)
SUPABASE_ACCESS_TOKEN=              # CLI auth for CI `supabase link` / `db push` (personal access token)
SUPABASE_PROJECT_REF=               # linked project ref for CI

# =============================================================================
# Notion project-memory bridge
# =============================================================================
NOTION_TOKEN=secret_xxx

# Select a project. Prefer page ID when available.
NOTION_PROJECT_PAGE_ID=
NOTION_PROJECT_NAME=

# Projects Knowledge
NOTION_PROJECTS_DB_ID=3cfe6070-43bc-80b5-85ee-c11fca9c994f
NOTION_PROJECTS_DATA_SOURCE_ID=3cfe6070-43bc-80e1-9708-000b7325b88d

